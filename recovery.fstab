# Android fstab for mlv5 / LG-M250

/boot           emmc     /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/boot           flags=display=Boot;backup=1;flashimg=1
/recovery       emmc     /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/recovery       flags=display=Recovery;backup=1;flashimg=1
/system         ext4     /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/system         flags=display=System;backup=1;wipeingui
/data           ext4     /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/userdata       flags=display=Data;encryptable=footer;length=-16384
/cache          ext4     /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/cache          flags=display=Cache;wipeingui;backup=1
/vendor         ext4     /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/vendor         flags=display=Vendor;backup=1;wipeingui
/cust           ext4     /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/cust           flags=display=Cust;backup=1
/OP             ext4     /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/OP             flags=display=OP;backup=1
/persist-lg     ext4     /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/persist_lg     flags=display=Persist-LG;backup=1
/nvdata         ext4     /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/nvdata         flags=display=NVData;backup=1
/misc           emmc     /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/para           flags=display=Misc
/misc2          emmc     /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/misc2          flags=display=Misc2
/frp            emmc     /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/frp            flags=display=FRP
/logo           emmc     /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/logo           flags=display=Logo;backup=1
/nvram          emmc     /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/nvram          flags=display=NVRAM;backup=1
/proinfo        emmc     /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/proinfo        flags=display=Proinfo;backup=1
/protect1       ext4     /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/protect1       flags=display=Protect1
/protect2       ext4     /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/protect2       flags=display=Protect2
/mpt            ext4     /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/mpt            flags=display=MPT
/power          ext4     /dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/power          flags=display=Power